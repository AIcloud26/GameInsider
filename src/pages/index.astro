---
import { site } from '@/sites';
import { gameBySlug } from '@/games';
import { resolveHomepage } from '@/engine/registry/homepage';
import { loadArticles } from '@/engine/content/query';
import BaseLayout from '@/engine/layouts/BaseLayout.astro';
import HeroSection from '@/engine/components/home/HeroSection.astro';
import ArticleRail from '@/engine/components/home/ArticleRail.astro';
import CategoryGrid from '@/engine/components/home/CategoryGrid.astro';
import GamesDirectory from '@/engine/components/home/GamesDirectory.astro';
import { sectionPath } from '@/engine/routing/paths';
import { websiteSchema } from '@/engine/seo/jsonld';
import type { Article } from '@/engine/content/query';

const primary = gameBySlug(site.primaryGame ?? '');
const sections = primary ? resolveHomepage(primary.homepage, primary.features) : ['games'];

let all: Article[] = [];
if (primary) all = await loadArticles(primary);

// Distinct selection logic for the three rails so cards never repeat:
//  Featured -> editor-pinned (frontmatter featured:true), newest first
//  Popular  -> explicit editor picks (popular:true), newest first
//  Latest   -> everything not already pinned in Featured, newest by date
const byDateDesc = (a: Article, b: Article) =>
  b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf();

const featured = all.filter((a) => a.data.featured).sort(byDateDesc);
const featuredIds = new Set(featured.map((a) => a.id));
const popular = all
  .filter((a) => a.data.popular && !featuredIds.has(a.id))
  .sort(byDateDesc);
const shownIds = new Set([...featured.map((a) => a.id), ...popular.map((a) => a.id)]);
const latest = all.filter((a) => !shownIds.has(a.id)).sort(byDateDesc);
---

<BaseLayout
  title={site.seo.defaultTitle}
  description={site.seo.defaultDescription}
  path="/"
  game={primary}
  jsonLd={websiteSchema(site)}
>
  {primary && sections.map((id) => {
    if (id === 'hero') return <HeroSection game={primary} />;
    if (id === 'featured-guides')
      return <ArticleRail game={primary} title="Featured Guides" articles={featured} seeAllPath={sectionPath(site, primary, 'guides')} />;
    if (id === 'popular-guides')
      return <ArticleRail game={primary} title="Editor's Picks" articles={popular} seeAllPath={sectionPath(site, primary, 'guides')} />;
    if (id === 'latest-guides')
      return <ArticleRail game={primary} title="Latest Guides" articles={latest} seeAllPath={sectionPath(site, primary, 'guides')} />;
    if (id === 'categories') return <CategoryGrid game={primary} />;
    if (id === 'games') return <GamesDirectory />;
    return null;
  })}
  {!primary && <GamesDirectory />}
</BaseLayout>
