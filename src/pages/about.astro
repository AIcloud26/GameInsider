---
import { withBase } from '@/engine/routing/paths';
import BaseLayout from '@/engine/layouts/BaseLayout.astro';
const title = 'About GameInsider';
const description =
  'GameInsider publishes clear, mobile-first English guides, codes and tier lists for popular mobile games.';
---

<BaseLayout title={`${title} | GameInsider`} description={description} path="/about/">
  <div class="container section legal">
    <h1>About GameInsider</h1>
    <p>GameInsider is an independent publisher of mobile game guides. Our goal is simple: help players progress faster with clear, accurate and mobile-friendly walkthroughs, redeem codes, hero rankings and event advice.</p>

    <h2>How we work</h2>
    <ul>
      <li>We focus on the information players actually search for: getting started, codes, heroes, tier lists and events.</li>
      <li>Guides are updated as the game changes. Anything we cannot confirm is clearly marked as pending verification rather than presented as fact.</li>
      <li>We keep pages fast and readable on phones, with no account required.</li>
    </ul>

    <h2>Editorial independence</h2>
    <p>GameInsider is not affiliated with, endorsed by or sponsored by the publishers of the games we cover. All game names, logos and trademarks are the property of their respective owners. We currently cover Kingshot by Century Games, with more games coming soon.</p>

    <h2>Contact</h2>
    <p>Found an error or want to suggest a game? Visit our <a href={withBase('/contact/')}>contact page</a>.</p>
  </div>
</BaseLayout>
