---
import { site } from '@/sites';
import type { GameConfig } from '@/engine/config/types';
import { sectionPath } from '@/engine/routing/paths';

interface Props { game: GameConfig; }
const { game } = Astro.props;
const visible = game.categories.filter((c) => game.features[c.feature]);
---

<section class="section">
  <div class="container">
    <div class="section-head"><h2>Browse by Category</h2></div>
    <div class="grid cols-2">
      {visible.map((c) => (
        <a class="cat-card" href={sectionPath(site, game, c.slug)}>
          <span class="cat-label">{c.label}</span>
          <span class="cat-desc muted">{c.description}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .cat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none !important;
  }
  .cat-label { font-weight: 800; font-size: 1.05rem; color: var(--text); }
  .cat-desc { font-size: .9rem; }
</style>
