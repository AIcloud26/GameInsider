---
import { site } from '@/sites';
import { games } from '@/games';
import { sectionPath } from '@/engine/routing/paths';

const year = new Date().getFullYear();
const legal = [
  { to: '/about/', label: 'About' },
  { to: '/contact/', label: 'Contact' },
  { to: '/privacy/', label: 'Privacy' },
  { to: '/terms/', label: 'Terms' },
  { to: '/cookie-policy/', label: 'Cookie Policy' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="footer-brand">
        <span class="brand-mark">◆</span> {site.siteName}
      </div>
      <p class="muted footer-tag">
        Independent mobile game guides. Not affiliated with the game publishers.
        Game names and trademarks belong to their respective owners.
      </p>
    </div>

    <div>
      <h4>Games</h4>
      <ul>
        {games.map((g) => (
          <li><a href={sectionPath(site, g)}>{g.name}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4>Site</h4>
      <ul>
        {legal.map((l) => <li><a href={l.to}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom muted">
    <span>© {year} {site.siteName}. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); background: var(--bg-soft); margin-top: 40px; }
  .footer-grid { display: grid; gap: 24px; padding: 32px 16px 16px; }
  @media (min-width: 760px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr; } }
  .footer-brand { font-weight: 800; font-size: 1.05rem; margin-bottom: 8px; }
  .brand-mark { color: var(--primary); }
  .footer-tag { font-size: .9rem; max-width: 46ch; }
  h4 { font-size: .85rem; text-transform: uppercase; letter-spacing: .6px; color: var(--text-muted); }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  ul a { color: var(--text); font-size: .94rem; }
  .footer-bottom { display: flex; justify-content: space-between; padding-top: 14px; padding-bottom: 22px; font-size: .85rem; border-top: 1px solid var(--border); margin-top: 8px; }
</style>
